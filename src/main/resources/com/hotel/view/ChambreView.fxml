<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.controller.ChambreController">
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Label text="🛏️ Gestion Chambres"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nouvelle" onAction="#showAddDialog"
                    style="-fx-background-color: #4f8ef7; -fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="chambreTable" style="-fx-padding: 10;">
            <columns>
                <TableColumn fx:id="colId"     text="ID"          prefWidth="50"/>
                <TableColumn fx:id="colNumero" text="Numéro"      prefWidth="80"/>
                <TableColumn fx:id="colType"   text="Type"        prefWidth="100"/>
                <TableColumn fx:id="colPrix"   text="Prix/nuit"   prefWidth="100"/>
                <TableColumn fx:id="colStatut" text="Statut"      prefWidth="100"/>
                <TableColumn fx:id="colActions" text="Actions"    prefWidth="120"/>
            </columns>
        </TableView>
    </center>
</BorderPane>