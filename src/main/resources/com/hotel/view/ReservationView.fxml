<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.controller.ReservationController"
      stylesheets="@style.css">

  <!-- ── TOPBAR ─────────────────────────────────── -->
  <HBox styleClass="topbar" alignment="CENTER_LEFT">
    <VBox spacing="2" HBox.hgrow="ALWAYS">
      <Label text="Gestion réservations" styleClass="page-title"/>
      <Label text="Suivez toutes les réservations en cours" styleClass="page-subtitle"/>
    </VBox>
    <HBox spacing="8" alignment="CENTER_RIGHT">
      <Button text="+ Nouvelle réservation"
              onAction="#showAddDialog"
              styleClass="btn-primary"/>
    </HBox>
  </HBox>

  <!-- ── TABLE ─────────────────────────────────── -->
  <VBox styleClass="table-wrap" VBox.vgrow="ALWAYS">
    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
      <HBox style="-fx-padding: 12 16 12 16; -fx-border-color: transparent transparent #E8ECF0 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
        <Label text="Liste des réservations" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1A1A2E;"/>
      </HBox>
      <TableView fx:id="reservationTable"
                 styleClass="table-view"
                 VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId"      text="ID"       prefWidth="55"/>
          <TableColumn fx:id="colClient"  text="CLIENT"   prefWidth="150"/>
          <TableColumn fx:id="colChambre" text="CHAMBRE"  prefWidth="85"/>
          <TableColumn fx:id="colArrivee" text="ARRIVÉE"  prefWidth="105"/>
          <TableColumn fx:id="colDepart"  text="DÉPART"   prefWidth="105"/>
          <TableColumn fx:id="colMontant" text="MONTANT"  prefWidth="95"/>
          <TableColumn fx:id="colStatut"  text="STATUT"   prefWidth="110"/>
          <TableColumn fx:id="colActions" text="ACTIONS"  prefWidth="140"/>
        </columns>
        <placeholder>
          <Label text="Aucune réservation trouvée"
                 style="-fx-text-fill: #9BA5B0; -fx-font-size: 14px;"/>
        </placeholder>
      </TableView>
    </VBox>
  </VBox>

</VBox>
