<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hotel.controller.AlerteController"
      spacing="0"
      style="-fx-background-color: #f8f9fc;">

    <!-- ══ EN-TÊTE ══════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1e1e32; -fx-padding: 18 24 18 24;">

        <Label text="🔔  Notifications"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblCompteur"
               style="-fx-font-size: 13px; -fx-text-fill: #b4c8ff;"/>

        <Button text="↻  Rafraîchir"
                onAction="#chargerAlertes"
                style="-fx-background-color: #3c4664;
                       -fx-text-fill: white;
                       -fx-font-size: 12px;
                       -fx-padding: 7 16 7 16;
                       -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- ══ BARRE DE STATS ═══════════════════════════════════════════════ -->
    <HBox spacing="12" style="-fx-padding: 12 24 8 24; -fx-background-color: #f8f9fc;">

        <!-- Critique -->
        <VBox alignment="CENTER"
              style="-fx-background-color: #fff0f0;
                     -fx-border-color: #dc3545;
                     -fx-border-width: 0 0 0 4;
                     -fx-background-radius: 0 8 8 0;
                     -fx-border-radius: 0 8 8 0;
                     -fx-padding: 10 18 10 14;">
            <Label text="🔴  Critique"
                   style="-fx-font-size: 11px; -fx-text-fill: #dc3545; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Attention -->
        <VBox alignment="CENTER"
              style="-fx-background-color: #fff8f0;
                     -fx-border-color: #fd7e14;
                     -fx-border-width: 0 0 0 4;
                     -fx-background-radius: 0 8 8 0;
                     -fx-border-radius: 0 8 8 0;
                     -fx-padding: 10 18 10 14;">
            <Label text="🟠  Attention"
                   style="-fx-font-size: 11px; -fx-text-fill: #fd7e14; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Info -->
        <VBox alignment="CENTER"
              style="-fx-background-color: #f0f4ff;
                     -fx-border-color: #0d6efd;
                     -fx-border-width: 0 0 0 4;
                     -fx-background-radius: 0 8 8 0;
                     -fx-border-radius: 0 8 8 0;
                     -fx-padding: 10 18 10 14;">
            <Label text="🔵  Info"
                   style="-fx-font-size: 11px; -fx-text-fill: #0d6efd; -fx-font-weight: bold;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Filtre -->
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Filtre :"
                   style="-fx-font-size: 13px; -fx-text-fill: #555;"/>
            <ComboBox fx:id="comboFiltre"
                      prefWidth="150"
                      style="-fx-font-size: 13px;"/>
        </HBox>
    </HBox>

    <!-- ══ SÉPARATEUR ═══════════════════════════════════════════════════ -->
    <Separator style="-fx-padding: 0 24 0 24;"/>

    <!-- ══ LISTE DES ALERTES ════════════════════════════════════════════ -->
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: #f8f9fc;"
                VBox.vgrow="ALWAYS">

        <VBox fx:id="listeAlertes"
              spacing="0"
              style="-fx-background-color: #f8f9fc; -fx-padding: 12 20 20 20;">
        </VBox>
    </ScrollPane>

</VBox>
