<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hotel.controller.LoginController"
           styleClass="login-root"
           stylesheets="@style.css">

    <VBox alignment="CENTER" spacing="0" maxWidth="380">

        <!-- CARD -->
        <VBox styleClass="login-card" spacing="20">

            <!-- TITRE -->
            <VBox spacing="4" alignment="CENTER">
                <Label text="Hôtel Manager" styleClass="login-title"/>
                <Label text="Connectez-vous à votre espace" styleClass="login-subtitle"/>
            </VBox>

            <!-- SEPARATEUR -->
            <Separator opacity="0.3"/>

            <!-- USERNAME -->
            <VBox spacing="6">
                <Label text="NOM D'UTILISATEUR" styleClass="login-label"/>
                <TextField fx:id="usernameField"
                           promptText="Entrez votre nom d'utilisateur"
                           styleClass="login-field"
                           prefWidth="300"/>
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="6">
                <Label text="MOT DE PASSE" styleClass="login-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Entrez votre mot de passe"
                               styleClass="login-field"
                               prefWidth="300"/>
            </VBox>

            <!-- ERROR -->
            <Label fx:id="errorLabel" styleClass="login-error" text=""/>

            <!-- BUTTON -->
            <Button text="Se connecter"
                    onAction="#handleLogin"
                    styleClass="login-btn"
                    prefWidth="300"
                    maxWidth="Infinity"/>

        </VBox>
    </VBox>
</StackPane>
