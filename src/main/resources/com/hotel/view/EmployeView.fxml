<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.controller.EmployeController">
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Label text="👷 Gestion Employés"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nouvel employé" onAction="#showAddDialog"
                    style="-fx-background-color: #34d399; -fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="employeTable" style="-fx-padding: 10;">
            <columns>
                <TableColumn fx:id="colId"      text="ID"        prefWidth="50"/>
                <TableColumn fx:id="colNom"     text="Nom"       prefWidth="120"/>
                <TableColumn fx:id="colPrenom"  text="Prénom"    prefWidth="120"/>
                <TableColumn fx:id="colRole"    text="Rôle"      prefWidth="100"/>
                <TableColumn fx:id="colTel"     text="Téléphone" prefWidth="110"/>
                <TableColumn fx:id="colStatut"  text="Statut"    prefWidth="90"/>
                <TableColumn fx:id="colActions" text="Actions"   prefWidth="120"/>
            </columns>
        </TableView>
    </center>
</BorderPane>